{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data/**",
              "components/lib/**",
              "components/navigation/**",
              "components/pills/**",
              "components/surfaces/**",
              "ui_kits/daily_planning/**",
              "ui_kits/order_management/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Noto Sans Thai|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Noto Sans Thai, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BubbleColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|hero|render|key|ref|className|style|children)$/]",
        "message": "<BubbleColumn> doesn't accept that prop. Declared props: key, label, align, hero, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='BubbleColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<BubbleColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|danger|default|cta)$/]",
        "message": "<Button> variant must be one of 'primary' | 'danger' | 'default' | 'cta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:soft|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: soft, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomerPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|variant|dim|ring|clickable|onClick|key|ref|className|style|children)$/]",
        "message": "<CustomerPill> doesn't accept that prop. Declared props: name, variant, dim, ring, clickable, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomerPill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|tint|neutral)$/]",
        "message": "<CustomerPill> variant must be one of 'solid' | 'tint' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeliveryTypePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|key|ref|className|style|children)$/]",
        "message": "<DeliveryTypePill> doesn't accept that prop. Declared props: type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeliveryTypePill'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:direct|dc|xdock|wholesale|retail|pickup)$/]",
        "message": "<DeliveryTypePill> type must be one of 'direct' | 'dc' | 'xdock' | 'wholesale' | 'retail' | 'pickup'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|color|children|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|accent|soft|key|ref|className|style|children)$/]",
        "message": "<KpiTile> doesn't accept that prop. Declared props: label, value, sub, accent, soft."
      },
      {
        "selector": "JSXOpeningElement[name.name='PackPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:family|count|children|key|ref|className|style|children)$/]",
        "message": "<PackPill> doesn't accept that prop. Declared props: family, count, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PackPill'] > JSXAttribute[name.name='family'] > Literal[value!=/^(?:tray|mat|pack|basket|egg|other)$/]",
        "message": "<PackPill> family must be one of 'tray' | 'mat' | 'pack' | 'basket' | 'egg' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|round|label|selected|small|key|ref|className|style|children)$/]",
        "message": "<RoundChip> doesn't accept that prop. Declared props: state, round, label, selected, small."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:open|closed|defer|all|inactive)$/]",
        "message": "<RoundChip> state must be one of 'open' | 'closed' | 'defer' | 'all' | 'inactive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:grade|children|key|ref|className|style|children)$/]",
        "message": "<SizePill> doesn't accept that prop. Declared props: grade, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizePill'] > JSXAttribute[name.name='grade'] > Literal[value!=/^(?:0|1|2|3|4|5|mix|un)$/]",
        "message": "<SizePill> grade must be one of '0' | '1' | '2' | '3' | '4' | '5' | 'mix' | 'un'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|children|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: state, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:draft|submitted|confirmed|editing)$/]",
        "message": "<StatusPill> state must be one of 'draft' | 'submitted' | 'confirmed' | 'editing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
